# ──────────────────────────────────────────────────────────────
# Cursor Metrics — Environment Variables
# Copy to .env and fill in real values before running.
# ──────────────────────────────────────────────────────────────

# Database connection string (MariaDB via aiomysql async driver)
DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/cursor_metrics

# Secret key for signing JWT session cookies (generate a strong random value)
SECRET_KEY=change-me-to-a-random-secret

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Set to true for development (enables reload, verbose errors)
DEBUG=false

# ── MariaDB container settings (used by docker-compose db service) ───
MARIADB_ROOT_PASSWORD=rootsecret
MARIADB_DATABASE=cursor_metrics
MARIADB_USER=user
MARIADB_PASSWORD=password
